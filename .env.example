# ==============================================================================
# iaparacasa - Configurações de Ambiente (Edge AI Home Automation)
# ==============================================================================

# Caminho do modelo quantizado GGUF
MODEL_PATH=./models/qwen2.5-1.5b-instruct-q4_k_m.gguf

# Repositório Hugging Face para download automático
MODEL_REPO_ID=Qwen/Qwen2.5-1.5B-Instruct-GGUF
MODEL_FILENAME=qwen2.5-1.5b-instruct-q4_k_m.gguf

# Ajustes de hardware para Edge AI (CPU/RAM modestas)
# n_ctx: 2048 tokens mantém o uso de memória KV-cache em ~150MB
N_CTX=2048
# n_threads: ideal entre 2 e 4 em processadores como Intel N100 ou RPi 4/5
N_THREADS=4
# n_batch: 256 ou 512 reduz picos momentâneos de alocação de RAM
N_BATCH=256
# use_mmap=false carrega o GGUF direto para RAM (evita gargalo em montagens WSL2/9P)
USE_MMAP=false

# Amostragem determinística para comandos lógicos de automação
TEMPERATURE=0.1
TOP_P=0.9

# Persistência e Memória Contínua (SQLite local)
DB_PATH=./data/iaparacasa_memory.db
MAX_SHORT_TERM_EVENTS=25

# Modo de simulação e Bridge Física Sonoff/eWeLink (CoolKit Open Platform v2 + LAN DIY)
USE_MOCK_ENGINE=false
ENABLE_HARDWARE_BRIDGE=false
EWELINK_CLOUD_TOKEN=
EWELINK_REFRESH_TOKEN=
EWELINK_APP_ID=
EWELINK_APP_SECRET=
EWELINK_REGION=us
EWELINK_COUNTRY_CODE=+55
EWELINK_USER_EMAIL=
EWELINK_USER_PASSWORD=
EWELINK_CLOUD_BASE_URL=https://web.ewelink.cc

# Servidor FastAPI
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

